# Server
PORT=8080

# MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DB=portfolio_admin

# JWT
JWT_SECRET=change-me-to-a-strong-random-string-in-production

# Initial Admin Credentials (used for seeding on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# CORS - only non-site origins (e.g. admin dashboard)
# Site domains (from DB) are allowed automatically via DomainCache
ALLOWED_ORIGINS=http://localhost:3001,https://admin.example.com
